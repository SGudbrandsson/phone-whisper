<?xml version="1.0" encoding="utf-8"?>
<!-- Allows plain http:// so a self-hosted transcription server on the local network works.
     https endpoints (OpenAI, Groq) are unaffected. The settings screen warns when http is used. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
